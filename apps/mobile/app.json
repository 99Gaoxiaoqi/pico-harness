{
  "expo": {
    "name": "Pico",
    "slug": "pico-mobile",
    "version": "0.1.2",
    "scheme": "pico",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.pico.mobile",
      "supportsTablet": true,
      "useAppleScene": true,
      "buildNumber": "3"
    },
    "android": {
      "package": "dev.pico.mobile",
      "permissions": ["CAMERA"],
      "versionCode": 3,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "扫码配对你的 Pico 电脑",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择图片发送给 Pico",
          "cameraPermission": "拍摄图片发送给 Pico",
          "microphonePermission": false
        }
      ],
      "./plugins/with-secure-android.cjs"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "platforms": ["ios", "android"],
    "extra": {
      "release": {
        "publisher": "",
        "privacyPolicyUrl": "",
        "supportUrl": "",
        "supportEmail": ""
      }
    }
  }
}
