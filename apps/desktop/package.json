{
  "name": "@pico/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env ../../scripts/run-desktop-forge.mjs start",
    "package": "node ../../scripts/run-desktop-forge.mjs package",
    "make": "node ../../scripts/run-desktop-forge.mjs make",
    "pretypecheck": "npm run build --workspace @pico/core && npm run build --workspace @pico/storage && npm run build --workspace @pico/runtime && npm run build --workspace @pico/protocol && npm run build --workspace @pico/transcript-replica && npm run build --workspace @pico/runtime-host && npm run build --workspace @pico/pico-host",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.2",
    "@astryxdesign/theme-neutral": "0.6.2",
    "@pico/pico-host": "*",
    "@pico/protocol": "*",
    "@pico/runtime": "*",
    "@pico/runtime-host": "*",
    "@pico/storage": "*",
    "@pico/transcript-replica": "*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@stylexjs/stylex": "0.19.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "node-pty": "^1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-base": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/maker-zip": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "vite": "^8.1.4"
  }
}
