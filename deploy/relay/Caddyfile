{$RELAY_DOMAIN} {
    @relay path /v1/health /v1/enroll /v1/relay
    handle @relay {
        reverse_proxy relay:8787 {
            # Replace client-supplied forwarding headers with the actual peer.
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        respond "Not found" 404
    }
}
